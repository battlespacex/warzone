      "category": "naval",
      "tags": [
        "ais",
        "naval",
        "fleet",
        "military"
      ]
    },
    {
      "name": "IsraelWarRoom Siren Feed",
      "enabled": true,
      "parser": "telegram",
      "category": "alert",
      "channels": [
        "IsraelWarRoom"
      ],
      "limit": 10,
      "tags": [
        "telegram",
        "siren",
        "israel",
        "military"
      ]
    },
    {
      "name": "Tzevaadom",
      "enabled": true,
      "parser": "telegram",
      "category": "alert",
      "channels": [
        "tzevaadom_en"
      ],
      "limit": 10,
      "tags": [
        "telegram",
        "siren",
        "israel",
        "military"
      ]
    },
    {
      "name": "Pikud HaOref Real-Time Sirens",
      "enabled": true,
      "type": "oref-poller",
      "parser": "oref",
      "url": "https://www.oref.org.il/WarningMessages/alert/alerts.json",
      "category": "alert",
      "tags": [
        "siren",
        "alert",
        "military"
      ]
    },
    {
      "name": "Manual Siren Alerts",
      "enabled": false,
      "parser": "alerts-array",
      "url": "${MANUAL_ALERTS_FEED_URL}",
      "category": "alert"
    },
    {
      "name": "CISA Cyber Threat Feed",
      "enabled": true,
      "parser": "cyber",
      "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
      "category": "cyber",
      "tags": [
        "cyber",
        "kev",
        "critical-infra"
      ]
    },
    {
      "name": "NASA FIRMS Thermal",
      "enabled": true,
      "parser": "firms",
      "url": "https://firms.modaps.eosdis.nasa.gov/api/area/csv/${NASA_FIRMS_MAP_KEY}/VIIRS_SNPP_NRT/${FIRMS_BBOX}/1",
      "category": "thermal",
      "tags": [
        "thermal",
        "strike-signal",
        "military"
      ]
    },
    {
      "name": "Cloudflare Radar Internet Outages",
      "parser": "network-cloudflare",
      "enabled": true,
      "url": "https://api.cloudflare.com/client/v4/radar/quality/outages/events?limit=50",
      "category": "network",
      "tags": [
        "network",
        "internet-outage",
        "cloudflare-radar",
        "critical-infra"
      ]
    },
    {
      "name": "IODA Internet Outages",
      "parser": "network-ioda",
      "enabled": true,
      "url": "https://api.ioda.inetintel.cc.gatech.edu/v2/",
      "category": "network",
      "tags": [
        "network",
        "internet-outage",
        "ioda",
        "critical-infra"
      ]
    },
    {
      "name": "OONI Network Blocking",
      "parser": "network-ooni",
      "enabled": true,
      "url": "https://api.ooni.io/api/v1/observations?limit=20",
      "category": "network",
      "tags": [
        "network",
        "blocking",
        "throttling",
        "censorship",
        "ooni",
        "critical-infra"
      ]
    },
    {
      "name": "Global NOTAM Alerts",
      "parser": "notam",
      "enabled": true,
      "url": "https://api.flightaware.com/notams",
      "category": "airspace",
      "tags": [
        "notam",
        "airspace",
        "aviation",
        "military"
      ]
    }
