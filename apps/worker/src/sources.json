{
  "feeds": [
    {
      "name": "Warzone Seed",
      "enabled": false,
      "type": "manual-json",
      "parser": "events-array",
      "url": "${SEED_FEED_URL}",
      "category": "strike"
    },
    {
      "name": "Telegram OSINT",
      "parser": "telegram",
      "enabled": true,
      "channels": [
        "sentdefender",
        "OSINTLive",
        "OSINTdefender",
        "WarMonitors",
        "milinfolive",
        "irannotam",
        "U_S_CENTCOM",
        "war_translated",
        "mmirlb",
        "ourwarstoday",
        "wor_mil_news",
        "strikemap"
      ],
      "limit": 30,
      "category": "military",
      "tags": [
        "telegram",
        "osint",
        "military"
      ]
    },
    {
      "name": "GDELT Conflict Signals",
      "parser": "gdelt",
      "enabled": true,
      "type": "gdelt-api",
      "url": "https://api.gdeltproject.org/api/v2/doc/doc",
      "poll_interval_ms": 60000,
      "category": "military",
      "tags": [
        "gdelt",
        "signal",
        "conflict"
      ]
    },
    {
      "name": "ACLED Conflict Feed",
      "parser": "acled",
      "enabled": true,
      "url": "https://acleddata.com/api/acled/read",
      "category": "conflict",
      "tags": [
        "acled",
        "conflict",
        "military"
      ]
    },
    {
      "name": "Reddit CombatFootage",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/CombatFootage/new.json",
      "category": "military",
      "tags": [
        "reddit",
        "combat"
      ]
    },
    {
      "name": "Reddit UkraineWar",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/UkraineWarVideoReport/new.json",
      "category": "military",
      "tags": [
        "reddit",
        "ukraine"
      ]
    },
    {
      "name": "ADS-B Military Aircraft",
      "enabled": true,
      "type": "adsb-opensky",
      "category": "military",
      "tags": [
        "adsb",
        "opensky",
        "military",
        "aircraft",
        "airforce"
      ]
    },
    {
      "name": "AIS Naval Vessels",
      "enabled": true,
