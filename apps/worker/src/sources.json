{
  "feeds": [
    {
      "name": "Warzone Seed",
      "enabled": false,
      "type": "manual-json",
      "parser": "events-array",
      "url": "${SEED_FEED_URL}",
      "category": "strike"
    },
    {
      "name": "Telegram OSINT High Signal",
      "parser": "telegram",
      "enabled": true,
      "channels": [
        "OSINTdefender",
        "OSINT_defender",
        "WarMonitors",
        "milinfolive",
        "war_translated",
        "ourwarstoday",
        "sitreports",
        "irannotam"
      ],
      "limit": 30,
      "category": "military",
      "tags": [ "telegram", "osint", "military", "high-signal" ]
    },
    {
      "name": "Telegram OSINT Mixed",
      "parser": "telegram",
      "enabled": true,
      "channels": [
        "sentdefender",
        "OSINTLive",
        "wor_mil_news",
        "CyberspecNews",
        "mmirlb",
        "i20028843",
        "EurasianChoice"
      ],
      "limit": 20,
      "category": "military",
      "tags": [ "telegram", "osint", "military", "mixed" ]
    },
    {
      "name": "Telegram Narrative / Official",
      "parser": "telegram",
      "enabled": true,
      "channels": [
        "U_S_CENTCOM",
        "IranintlTV",
        "RedLionCorps",
        "china3army",
        "farsivoa",
        "euronewspe",
        "intelslava"
      ],
      "limit": 15,
      "category": "military",
      "tags": [ "telegram", "osint", "military", "narrative" ]
    },
    {
      "name": "GDELT Conflict Signals",
      "parser": "gdelt",
      "enabled": true,
      "type": "gdelt-api",
      "url": "https://api.gdeltproject.org/api/v2/doc/doc",
      "poll_interval_ms": 60000,
      "category": "military",
      "tags": [ "gdelt", "signal", "conflict" ]
    },
    {
      "name": "UCDP Conflict Events",
      "type": "ucdp",
      "parser": "ucdp",
      "enabled": true,
      "category": "strike",
      "url": "https://ucdpapi.pcr.uu.se/api/gedevents/23.1?pagesize=100",
      "tags": [ "ucdp", "conflict", "military" ]
    },
    {
      "name": "ACLED Conflict Feed",
      "parser": "acled",
      "enabled": false,
      "url": "https://acleddata.com/api/acled/read",
      "category": "conflict",
      "tags": [ "acled", "conflict", "military" ]
    },
    {
      "name": "Reddit CombatFootage",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/CombatFootage/new.json",
      "category": "military",
      "tags": [ "reddit", "combat" ]
    },
    {
      "name": "Reddit UkraineWar",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/UkraineWarVideoReport/new.json",
      "category": "military",
      "tags": [ "reddit", "ukraine" ]
    },
    {
      "name": "Reddit MiddleEastNews",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/MiddleEastNews/new.json",
      "category": "military",
      "tags": [ "reddit", "middle-east" ]
    },
    {
      "name": "Reddit WorldNews Military",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/worldnews/search.json?q=military+strike+missile+drone&sort=new&restrict_sr=1",
      "category": "military",
      "tags": [ "reddit", "worldnews", "military" ]
    },
    {
      "name": "Reddit GeopoliticsConflict",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/geopolitics/new.json",
      "category": "military",
      "tags": [ "reddit", "geopolitics" ]
    },
    {
      "name": "ADS-B Military Aircraft",
      "enabled": true,
      "type": "adsb-opensky",
      "category": "military",
      "tags": [ "adsb", "opensky", "military", "aircraft", "airforce" ]
    },
    {
      "name": "AIS Naval Vessels",
      "enabled": true,
      "type": "ais-stream",
      "category": "naval",
      "tags": [ "ais", "naval", "fleet", "military" ]
    },
    {
      "name": "IsraelWarRoom Siren Feed",
      "enabled": true,
      "parser": "telegram",
      "category": "alert",
      "channels": [ "IsraelWarRoom" ],
      "limit": 10,
      "tags": [ "telegram", "siren", "israel", "military" ]
    },
    {
      "name": "Tzevaadom",
      "enabled": true,
      "parser": "telegram",
      "category": "alert",
      "channels": [ "tzevaadom_en" ],
      "limit": 10,
      "tags": [ "telegram", "siren", "israel", "military" ]
    },
    {
      "name": "Pikud HaOref Real-Time Sirens",
      "enabled": true,
      "type": "oref-poller",
      "parser": "oref",
      "url": "https://www.oref.org.il/WarningMessages/alert/alerts.json",
      "category": "alert",
      "tags": [ "siren", "alert", "military" ]
    },
    {
      "name": "Manual Siren Alerts",
      "enabled": false,
      "parser": "alerts-array",
      "url": "${MANUAL_ALERTS_FEED_URL}",
      "category": "alert"
    },
    {
      "name": "CISA Cyber Threat Feed",
      "enabled": true,
      "parser": "cyber",
      "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
      "category": "cyber",
      "tags": [ "cyber", "kev", "critical-infra" ]
    },
    {
      "name": "NASA FIRMS Thermal",
      "enabled": true,
      "parser": "firms",
      "url": "https://firms.modaps.eosdis.nasa.gov/api/area/csv/${NASA_FIRMS_MAP_KEY}/VIIRS_SNPP_NRT/${FIRMS_BBOX}/1",
      "category": "thermal",
      "tags": [ "thermal", "strike-signal", "military" ]
    },
    {
      "name": "USGS Seismic Monitor",
      "parser": "usgs",
      "enabled": true,
      "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson",
      "category": "seismic",
      "tags": [ "usgs", "seismic", "explosion-signal" ]
    },
    {
      "name": "Cloudflare Radar Internet Outages",
      "parser": "network-cloudflare",
      "enabled": true,
      "url": "https://api.cloudflare.com/client/v4/radar/quality/outages/events?limit=50",
      "category": "network",
      "tags": [ "network", "internet-outage", "cloudflare-radar", "critical-infra" ]
    },
    {
      "name": "IODA Internet Outages",
      "parser": "network-ioda",
      "enabled": true,
      "url": "https://api.ioda.inetintel.cc.gatech.edu/v2/",
      "category": "network",
      "tags": [ "network", "internet-outage", "ioda", "critical-infra" ]
    },
    {
      "name": "OONI Network Blocking",
      "parser": "network-ooni",
      "enabled": true,
      "url": "https://api.ooni.io/api/v1/observations?limit=20",
      "category": "network",
      "tags": [ "network", "blocking", "censorship", "ooni", "critical-infra" ]
    },
    {
      "name": "Global NOTAM Alerts",
      "parser": "notam-api",
      "enabled": true,
      "url": "https://www.notams.faa.gov/dinsQueryWeb/queryRetrievalMapAction.do",
      "category": "airspace",
      "tags": [ "notam", "airspace", "aviation", "military" ]
    }
  ]
}