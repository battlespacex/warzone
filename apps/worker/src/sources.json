{
  "feeds": [
    {
      "name": "Warzone Seed",
      "enabled": false,
      "type": "manual-json",
      "parser": "events-array",
      "url": "${SEED_FEED_URL}",
      "category": "strike"
    },
    {
      "name": "Telegram OSINT",
      "parser": "telegram",
      "enabled": true,
      "channels": [
        "sentdefender",
        "OSINTLive",
        "OSINTdefender",
        "WarMonitors",
        "milinfolive",
        "irannotam",
        "U_S_CENTCOM",
        "war_translated",
        "mmirlb",
        "ourwarstoday",
        "wor_mil_news",
        "strikemap"
      ],
      "limit": 30,
      "category": "military",
      "tags": [
        "telegram",
        "osint",
        "military"
      ]
    },
    {
      "name": "GDELT Conflict Signals",
      "parser": "gdelt",
      "enabled": false,
      "type": "gdelt-api",
      "url": "https://api.gdeltproject.org/api/v2/doc/doc",
      "poll_interval_ms": 60000,
      "category": "military",
      "tags": [
        "gdelt",
        "signal"
      ]
    },
    {
      "name": "ACLED Conflict Feed",
      "parser": "acled",
      "enabled": false,
      "url": "https://acleddata.com/api/acled/read",
      "category": "conflict",
      "tags": [
        "acled",
        "conflict"
      ]
    },
    {
      "name": "Reddit CombatFootage",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/CombatFootage/new.json",
      "category": "military",
      "tags": [
        "reddit",
        "combat"
      ]
    },
    {
      "name": "Reddit UkraineWar",
      "parser": "reddit",
      "enabled": true,
      "url": "https://www.reddit.com/r/UkraineWarVideoReport/new.json",
      "category": "military",
      "tags": [
        "reddit",
        "ukraine"
      ]
    },
    {
      "name": "ADS-B Military Aircraft",
      "enabled": true,
      "type": "adsb-opensky",
      "category": "military",
      "tags": [ "adsb", "opensky", "military", "aircraft", "airforce" ]
    },
    {
      "name": "AIS Naval Vessels",
      "enabled": true,
      "type": "ais-stream",
      "category": "naval",
      "tags": [ "ais", "naval", "fleet" ]
    },
    {
      "name": "IsraelWarRoom Siren Feed",
      "enabled": true,
      "parser": "telegram",
      "category": "alert",
      "channels": [
        "IsraelWarRoom"
      ],
      "limit": 10,
      "tags": [
        "telegram",
        "siren",
        "israel"
      ]
    },
    {
      "name": "Tzevaadom",
      "enabled": true,
      "parser": "telegram",
      "category": "alert",
      "channels": [
        "tzevaadom_en"
      ],
      "limit": 10,
      "tags": [
        "telegram",
        "siren",
        "israel"
      ]
    },
    {
      "name": "Pikud HaOref Real-Time Sirens",
      "enabled": false,
      "type": "oref-poller",
      "parser": "oref",
      "url": "https://www.oref.org.il/WarningMessages/alert/alerts.json",
      "category": "alert"
    },
    {
      "name": "Manual Siren Alerts",
      "enabled": false,
      "parser": "alerts-array",
      "url": "${MANUAL_ALERTS_FEED_URL}",
      "category": "alert"
    },
    {
      "name": "CISA Cyber Threat Feed",
      "enabled": true,
      "parser": "cyber",
      "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
      "category": "cyber",
      "tags": [
        "cyber",
        "kev"
      ]
    },
    {
      "name": "USGS Earthquake Feed",
      "enabled": false,
      "parser": "usgs",
      "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson",
      "category": "signal"
    },
    {
      "name": "NASA FIRMS Thermal",
      "enabled": false,
      "parser": "firms",
      "url": "https://firms.modaps.eosdis.nasa.gov/api/area/csv/${NASA_FIRMS_MAP_KEY}/VIIRS_SNPP_NRT/${FIRMS_BBOX}/1",
      "category": "thermal"
    },
    {
      "name": "NASA EONET",
      "enabled": false,
      "parser": "eonet",
      "url": "https://eonet.gsfc.nasa.gov/api/v3/events",
      "category": "fire"
    },
    {
      "name": "Cloudflare Radar Internet Outages",
      "parser": "network-cloudflare",
      "enabled": false,
      "url": "https://api.cloudflare.com/client/v4/radar/quality/outages/events?limit=50",
      "category": "network",
      "tags": [ "network", "internet-outage", "cloudflare-radar" ]
    },
    {
      "name": "IODA Internet Outages",
      "parser": "network-ioda",
      "enabled": true,
      "url": "https://api.ioda.inetintel.cc.gatech.edu/v2/",
      "category": "network",
      "tags": [ "network", "internet-outage", "ioda" ]
    },
    {
      "name": "OONI Network Blocking",
      "parser": "network-ooni",
      "enabled": true,
      "url": "https://api.ooni.io/api/v1/observations?limit=20",
      "category": "network",
      "tags": [ "network", "blocking", "throttling", "censorship", "ooni" ]
    }
  ]
}