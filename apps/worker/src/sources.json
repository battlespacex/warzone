    {
      "name": "GDELT Conflict Signals",
      "parser": "gdelt",
      "enabled": true,
      "type": "gdelt-api",
      "url": "https://api.gdeltproject.org/api/v2/doc/doc",
      "poll_interval_ms": 60000,
      "category": "military",
      "query": "(missile OR drone OR airstrike OR warship OR artillery OR fighter) AND (Israel OR Iran OR Lebanon OR Syria OR Iraq OR Yemen OR Ukraine OR Russia)",
      "mode": "ArtList",
      "format": "json",
      "maxrecords": 75,
      "sort": "DateDesc",
      "timespan": "6h",
