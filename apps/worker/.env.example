# Existing worker credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aircraft provider orchestration
AIRCRAFT_PROVIDER_PRIORITY=adsb_lol,airplanes_live,adsb_one,adsb_exchange,opensky
AIRCRAFT_CORROBORATION_WINDOW_MS=90000
AIRCRAFT_MAX_PLAUSIBLE_SPEED_KTS=1800
ADSB_LOL_ENABLED=true
ADSB_LOL_BASE_URL=https://api.adsb.lol
ADSB_LOL_POSITION_MAX_AGE_SECONDS=90
AIRPLANES_LIVE_ENABLED=true
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live/v2/mil
ADSB_ONE_ENABLED=true
ADSB_ONE_BASE_URL=https://api.adsb.one/v2/mil
ADSB_EXCHANGE_ENABLED=false
ADSB_EXCHANGE_API_KEY=
ADSB_EXCHANGE_BASE_URL=https://www.adsbexchange.com/api/aircraft/v2/mil
OPENSKY_ENABLED=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BASE_URL=https://opensky-network.org/api/states/all

# Naval provider orchestration
NAVAL_PROVIDER_PRIORITY=aisstream,aishub,spire,marinetraffic
NAVAL_CORROBORATION_WINDOW_MS=600000
NAVAL_MAX_PLAUSIBLE_SPEED_KTS=80
AISSTREAM_ENABLED=true
AISSTREAM_API_KEY=
AISSTREAM_BASE_URL=wss://stream.aisstream.io/v0/stream
AISSTREAM_SESSION_DURATION_MS=60000
AISSTREAM_ALLOW_INSECURE_TLS_FALLBACK=true
AISHUB_ENABLED=false
AISHUB_USERNAME=
AISHUB_BASE_URL=https://data.aishub.net/ws.php
AISHUB_MINIMUM_INTERVAL_MS=60000
MARINETRAFFIC_ENABLED=false
MARINETRAFFIC_API_KEY=
# Customer-specific MarineTraffic/Kpler service endpoint; no default is assumed.
MARINETRAFFIC_BASE_URL=
SPIRE_AIS_ENABLED=false
SPIRE_AIS_TOKEN=
SPIRE_AIS_BASE_URL=https://api.spire.com/graphql
