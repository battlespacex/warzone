<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>

                <!-- Strip public /api prefix before forwarding to Node -->
                <rule name="ReverseProxyApi" stopProcessing="true">
                    <match url="^api/(.*)$" />
                    <action type="Rewrite" url="http://localhost:8080/{R:1}" />
                </rule>

                <!-- Existing direct API routing -->
                <rule name="ReverseProxy" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:8080/{R:1}" />
                </rule>

            </rules>
        </rewrite>
    </system.webServer>
</configuration>