# Backend only. Placeholder configuration; no source is enabled by this file.
NOTICES_ENABLED=false
NOTICES_IMPORT_FILE=
NOTICES_IMPORT_USAGE_APPROVED=false
# Import records must carry issuer, original HTTPS publication URL and reviewed validity.
SKYSPY_ENABLED=false
SKYSPY_NOTAMS_ENABLED=false
SKYSPY_AIRCRAFT_ENABLED=false
SKYSPY_USAGE_APPROVED=false
SKYSPY_BASE_URL=https://YOUR_AUTHORIZED_SERVICE_HOST
SKYSPY_ALLOWED_HOSTS=YOUR_AUTHORIZED_SERVICE_HOST
SKYSPY_API_KEY=
SKYSPY_STREAM_ENABLED=false
# native: documented Django Channels JSON protocol; socketio: optional Socket.IO client.
SKYSPY_TRANSPORT=native

# Server-side only; source agreement and redistribution rights must be approved.
AVIATION_EDGE_ENABLED=false
AVIATION_EDGE_USAGE_APPROVED=false
AVIATION_EDGE_API_KEY=
# One reviewed airport/FIR location; never an automatic global query.
AVIATION_EDGE_LOCATIONS=
AUTOROUTER_ENABLED=false
AUTOROUTER_USAGE_APPROVED=false
# Authorized OAuth access token; never a browser token or a fabricated login.
AUTOROUTER_ACCESS_TOKEN=
AUTOROUTER_LOCATIONS=
# Optional Unix-second validity query bounds; documented defaults cover all validity.
AUTOROUTER_START_VALIDITY=0
AUTOROUTER_END_VALIDITY=4294967295
# Contract gates remain closed even if flags are set, until actual schemas/URLs are verified.
ICAO_ENABLED=false
ICAO_USAGE_APPROVED=false
ICAO_API_KEY=
DTN_ENABLED=false
DTN_USAGE_APPROVED=false
DTN_API_KEY=
